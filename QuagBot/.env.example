# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API.
# NEXT_PUBLIC_ values are shipped to the browser, so only the URL and the
# PUBLISHABLE key go here. Never the secret / service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
